quant_framework/
│
├── main.py                      # 主程序入口
├── config.py                    # 配置文件，如数据源、交易参数
├── requirements.txt             # Python依赖库
│
├── core/                        # 核心模块
│   ├── data_loader.py           # 数据加载与预处理（多数据源支持）
│   ├── engine.py                # 执行引擎，驱动策略、回测、模拟
│   ├── portfolio.py             # 投资组合管理（组合构建与优化）
│   ├── order_executor.py        # 下单模块（真实/模拟）
│
├── strategy_pool/              # 策略池（策略定义与调用）
│   ├── base_strategy.py         # 策略基类
│   ├── mean_reversion.py        # 示例：均值回归策略
│   └── momentum.py              # 示例：动量策略
│
├── factor_pool/                # 因子池（支持因子生成、组合、管理）
│   ├── base_factor.py           # 因子基类
│   ├── factor_momentum.py       # 示例动量因子
│   └── factor_value.py          # 示例估值因子
│
├── utils/                      # 工具函数
│   ├── logger.py                # 日志模块
│   ├── performance.py           # 绩效分析（夏普比率、IC等）
│   ├── signal_generator.py      # 因子/策略生成信号
│
├── backtest/                   # 回测框架
│   ├── backtest_engine.py       # 回测主引擎
│   ├── metrics.py               # 回测结果评估
│   └── visualizer.py            # 可视化模块
│
├── tests/                      # 单元测试
│   └── test_engine.py
│
└── notebooks/                  # 研究和实验用的 Jupyter 笔记本
    └── strategy_analysis.ipynb
